generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model product {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  nombre     String
  precio     Decimal   @db.Decimal
  categoria  String
  imagen     String
  popular    Boolean?  @default(false)
  stock      Int?      @default(0)

  @@map("products")
}

model order {
  id         String    @id @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user_id    String?
  status     String?   @default("Pendiente")

  @@map("orders")
}

model hero_slide {
  id          BigInt    @id @default(autoincrement())
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  subtitle    String
  title       String
  description String
  cta_text    String?   @default("Ver Catalogo")
  cta_link    String?   @default("/catalogo")
  image_url   String
  order       Int?      @default(0) @map("order")
  active      Boolean?  @default(true)

  @@map("hero_slides")
}

model promotion {
  id               BigInt    @id @default(autoincrement())
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  title            String
  description      String
  image_url        String
  original_price   Decimal   @db.Decimal
  sale_price       Decimal   @db.Decimal
  discount_percent Int       @default(dbgenerated()) @db.Integer
  cta_link         String?   @default("/catalogo")
  active           Boolean?  @default(true)
  expires_at       DateTime? @db.Timestamptz(6)

  @@map("promotions")
}

model testimonial {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  name       String
  role       String?   @default("Cliente")
  avatar_url String?
  text       String
  rating     Int?      @default(5)
  active     Boolean?  @default(true)

  @@map("testimonials")
}

